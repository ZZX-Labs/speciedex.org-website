{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speciedex.org/static/tools/providers/schemas/fao_asfis.schema.json",
  "title": "FAO ASFIS Speciedex normalized provider record",
  "description": "Adapter-contract schema for normalized records emitted by the FAO ASFIS provider. This is a Speciedex normalization contract, not a claim that the upstream service schema has been live-verified.",
  "type": "object",
  "required": [
    "provider",
    "provider_id",
    "scientific_name",
    "canonical_name",
    "rank",
    "status",
    "synonyms",
    "extra"
  ],
  "properties": {
    "provider": {
      "const": "fao_asfis"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "scientific_name": {
      "type": "string",
      "minLength": 1
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "rank": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "authorship": {
      "type": "string"
    },
    "kingdom": {
      "type": "string"
    },
    "phylum": {
      "type": "string"
    },
    "class": {
      "type": "string"
    },
    "order": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "genus": {
      "type": "string"
    },
    "accepted_provider_id": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_modified": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extra": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "x-speciedex": {
    "provider": "fao_asfis",
    "label": "FAO ASFIS",
    "adapter": "file_jsonl",
    "runtime_mode": "local_dataset",
    "role": "fisheries_species_reference",
    "module": "providers.fao_asfis",
    "upstream_api_url": null,
    "site_url": "https://www.fao.org/fishery/en/collection/asfis",
    "documentation_url": "https://www.fao.org/fishery/en/collection/asfis",
    "required_env": [],
    "dataset_path": "static/data/import/fao-asfis.jsonl",
    "upstream_verification": {
      "status": "unverified",
      "last_verified_at": null,
      "http_status": null,
      "notes": "Verify live URL, access terms, authentication, rate limits, and response shape before enabling."
    }
  }
}
